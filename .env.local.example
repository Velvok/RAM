# Copia este fichero a .env.local y rellena los valores.
# NUNCA pongas aquí valores reales: este fichero está en git.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Vercel AI
OPENAI_API_KEY=<openai-api-key>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ERP Evo: secreto de los webhooks entrantes y token de la API saliente
EVO_WEBHOOK_SECRET=<secreto-webhooks-evo>
EVO_API_URL=<url-api-evo>
EVO_API_KEY=<token-api-evo>

# Cron / worker de la cola saliente (sin él, esas rutas responden 503)
CRON_SECRET=<secreto-cron>

# Opcional: secreto para firmar la sesión de planta. Si falta, se deriva de
# SUPABASE_SERVICE_ROLE_KEY.
# PLANTA_SESSION_SECRET=<secreto-largo-aleatorio>
